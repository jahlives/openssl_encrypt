# Database Configuration
DATABASE_URL=postgresql://keyserver:your_password@localhost:5432/keyserver
DB_PASSWORD=your_secure_password

# Security
API_TOKEN_SALT=your_secret_salt_change_in_production

# Server Configuration
DEBUG=false
API_PORT=8080

# CORS (comma-separated origins)
CORS_ORIGINS=*

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_UPLOAD_PER_DAY=10
