#!/usr/bin/env python3
"""
Launcher script for the OpenSSL Encrypt Flatpak package (CLI-only app).

Since the two-app Flatpak split, this package ships the command-line tool
only; the desktop GUI is its own Flatpak app
(com.opensslencrypt.OpenSSLEncryptGui, built from the openssl_encrypt_gui
repository).
"""

import os
import sys

# Add the application directory to Python path
app_dir = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, app_dir)


def main():
    """Main launcher function."""
    if len(sys.argv) > 1 and "--gui" in sys.argv:
        print(
            "❌ This Flatpak ships the command-line tool only.",
            file=sys.stderr,
        )
        print(
            "💡 The desktop GUI is a separate Flatpak app. Install and run it with:",
            file=sys.stderr,
        )
        print(
            "   flatpak install openssl-encrypt-gui com.opensslencrypt.OpenSSLEncryptGui",
            file=sys.stderr,
        )
        print(
            "   flatpak run com.opensslencrypt.OpenSSLEncryptGui",
            file=sys.stderr,
        )
        sys.exit(1)

    # Launch CLI
    try:
        from openssl_encrypt.cli import main as cli_main

        cli_main()
    except ImportError:
        print("Error: CLI components not available", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
