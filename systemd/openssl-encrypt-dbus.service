[Unit]
Description=openssl_encrypt D-Bus Cryptographic Service (per-user session service)
Documentation=https://gitlab.rm-rf.ch/world/openssl_encrypt
After=dbus.service

# This is a USER unit (systemctl --user) bound to the per-user session bus.
# For the polkit-authorized system-bus service (admin access to root-only
# files) see openssl-encrypt-dbus-system.service.

[Service]
Type=dbus
BusName=ch.rmrf.openssl_encrypt
ExecStart=/usr/bin/python3 -m openssl_encrypt.modules.dbus_service

# Security hardening (key-handling process - L8)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/openssl_encrypt
UMask=0077
LimitCORE=0
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
ProtectProc=invisible
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
CapabilityBoundingSet=
# MemoryDenyWriteExecute is intentionally NOT set: cffi/libffi closures
# (liboqs bindings) need writable+executable trampoline pages.

# Resource limits
MemoryMax=1G
TasksMax=50
CPUQuota=200%

# Restart policy
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
